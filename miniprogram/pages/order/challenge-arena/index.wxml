<view class="challenge-container">
  <!-- 顶部活动规则提示 -->
  <view class="challenge-header">
    <view class="badge">{{activityMode === 'TEST' ? '测试演练模式' : '真技巧 · 零套路'}}</view>
    <view class="title">{{targetTime}} 秒极速挑战免单</view>
    <view class="subtitle">点击【开始】启动计时，凭节奏感正好在 {{targetTime}} 秒点击【停！】，误差 ≤ {{toleranceMs}}ms 即可全额免单</view>
  </view>

  <!-- 倒计时/计时仪表盘核心 -->
  <view class="timer-card">
    <view class="timer-target-tag">目标时间：{{targetTime}} 秒 (容差 ±{{toleranceMs}}ms)</view>
    <view class="timer-number {{status === 'RUNNING' ? 'active' : ''}}">
      {{displayTime}}
      <text class="unit">s</text>
    </view>
    
    <!-- 状态文字指示 -->
    <view class="status-tip">
      <block wx:if="{{status === 'READY'}}">
        <text>请准备好节奏感，点击下方按钮开始挑战</text>
      </block>
      <block wx:elif="{{status === 'STARTING'}}">
        <text>正在向云端申请安全挑战凭证...</text>
      </block>
      <block wx:elif="{{status === 'RUNNING'}}">
        <text class="recording">计时中！凭节奏在 {{targetTime}} 秒瞬间按下【停！】</text>
      </block>
      <block wx:elif="{{status === 'SUBMITTING'}}">
        <text>正在提交双向高精度时序验证...</text>
      </block>
      <block wx:elif="{{status === 'INTERRUPTED'}}">
        <text class="lose-text">⚠️ 遭遇网络或技术异常，挑战资格已安全锁存</text>
      </block>
      <block wx:elif="{{status === 'COMPLETED'}}">
        <block wx:if="{{isPendingReview}}">
          <text class="lose-text">🔍 成绩转入安全复核队列，订单已安全锁定</text>
        </block>
        <block wx:elif="{{isWinner}}">
          <text class="win-text">🎉 恭喜挑战成功！已为您触发全额免单退款</text>
        </block>
        <block wx:else>
          <text class="lose-text">距离 {{targetTime}} 秒偏差 {{result.diffMs}}ms，商品已为您安排正常履约发货</text>
        </block>
      </block>
    </view>
  </view>

  <!-- 核心互动控制圆盘：“开始 → 停止” -->
  <view class="control-area">
    <!-- 就绪态：显示【开始挑战】 -->
    <block wx:if="{{status === 'READY'}}">
      <view class="pulse-ring">
        <view class="challenge-trigger-btn ready-state" bindtap="onStartClick">
          <view class="inner-circle">
            <view class="btn-title">开始挑战</view>
            <view class="btn-desc">点击即刻启动</view>
          </view>
        </view>
      </view>
    </block>

    <!-- 启动中：加载动画 -->
    <block wx:elif="{{status === 'STARTING'}}">
      <view class="pulse-ring">
        <view class="challenge-trigger-btn pressed">
          <view class="inner-circle">
            <view class="btn-title">启动中...</view>
            <view class="btn-desc">建立安全信道</view>
          </view>
        </view>
      </view>
    </block>

    <!-- 运行中：显示醒目高亮【停！】 -->
    <block wx:elif="{{status === 'RUNNING'}}">
      <view class="pulse-ring animating">
        <view class="challenge-trigger-btn stop-state" bindtap="onStopClick">
          <view class="inner-circle">
            <view class="btn-title">停！</view>
            <view class="btn-desc">精准定格</view>
          </view>
        </view>
      </view>
    </block>

    <!-- 提交中 -->
    <block wx:elif="{{status === 'SUBMITTING'}}">
      <view class="pulse-ring">
        <view class="challenge-trigger-btn pressed">
          <view class="inner-circle">
            <view class="btn-title">结算中</view>
            <view class="btn-desc">核验中...</view>
          </view>
        </view>
      </view>
    </block>

    <!-- 中断异常可恢复状态 -->
    <block wx:elif="{{status === 'INTERRUPTED'}}">
      <view class="result-board" style="border-color: #f59e0b;">
        <view class="result-icon-badge">
          <text>⏱️</text>
        </view>
        <view class="result-title" style="color: #b45309;">挑战意外中断</view>
        <view class="result-detail-text" style="margin-top: 12rpx;">
          检测到网络抖动或程序意外中断。系统绝不会将您草率判负，已为您安全保留恢复挑战机会。
        </view>
        <view class="action-buttons" style="margin-top: 24rpx;">
          <button class="primary-btn" bindtap="onResumeSession">恢复挑战</button>
          <button class="secondary-btn" bindtap="onSkipChallenge">放弃并直接发货</button>
        </view>
      </view>
    </block>

    <!-- 挑战结算结果展示板 -->
    <block wx:elif="{{status === 'COMPLETED'}}">
      <view class="result-board {{isPendingReview ? '' : (isWinner ? 'winner' : 'loser')}}">
        <view class="result-icon-badge">
          <text wx:if="{{isPendingReview}}">🛡️</text>
          <text wx:elif="{{isWinner}}">🏆</text>
          <text wx:else>📦</text>
        </view>
        <view class="result-title">
          {{isPendingReview ? '风控复核中' : (isWinner ? '免单达成！' : '挑战遗憾失利')}}
        </view>
        
        <view class="result-stat-row">
          <view class="stat-item">
            <view class="stat-label">您的成绩</view>
            <view class="stat-val">{{displayTime}}s</view>
          </view>
          <view class="stat-item">
            <view class="stat-label">目标时间</view>
            <view class="stat-val">{{targetTime}}s</view>
          </view>
          <view class="stat-item">
            <view class="stat-label">毫秒偏差</view>
            <view class="stat-val">{{result.diffMs != null ? result.diffMs + 'ms' : '--'}}</view>
          </view>
        </view>

        <view class="result-detail-text">
          <block wx:if="{{isPendingReview}}">
            时序指标异常漂移，为确保公平公正已进入管理员审核通道。订单已锁定。
          </block>
          <block wx:elif="{{isWinner}}">
            神级反应！实付金额将原路全额返还，订单正常发货给您！
          </block>
          <block wx:else>
            非常接近了！感谢您的参与，商品将按照正常流程发货。
          </block>
        </view>

        <view class="action-buttons">
          <button class="primary-btn" bindtap="onBackToOrder">查看订单详情</button>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部操作选项：未开始挑战时允许放弃 -->
  <view class="footer-actions" wx:if="{{status === 'READY'}}">
    <view class="skip-btn" bindtap="onSkipChallenge">不参与挑战，直接发货</view>
  </view>
</view>

<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
