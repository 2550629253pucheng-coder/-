.challenge-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #064e3b 0%, #022c22 100%);
  color: #ffffff;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.challenge-header {
  text-align: center;
  margin-top: 20rpx;
}

.challenge-header .badge {
  display: inline-block;
  background: rgba(16, 185, 129, 0.2);
  border: 1px solid rgba(16, 185, 129, 0.4);
  color: #34d399;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}

.challenge-header .title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #f8fafc;
}

.challenge-header .subtitle {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 12rpx;
  line-height: 1.5;
  padding: 0 40rpx;
}

.timer-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin: 40rpx 0;
}

.timer-target-tag {
  font-size: 24rpx;
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.timer-number {
  font-size: 108rpx;
  font-weight: 900;
  font-family: monospace, -apple-system, sans-serif;
  color: #f8fafc;
  margin: 28rpx 0 16rpx;
  letter-spacing: 4rpx;
  transition: all 0.1s ease;
}

.timer-number.active {
  color: #34d399;
  transform: scale(1.04);
}

.timer-number .unit {
  font-size: 40rpx;
  font-weight: 600;
  color: #64748b;
  margin-left: 8rpx;
}

.status-tip {
  font-size: 26rpx;
  color: #cbd5e1;
  min-height: 40rpx;
}

.status-tip .recording {
  color: #fbbf24;
  font-weight: 600;
}

.status-tip .win-text {
  color: #34d399;
  font-weight: 600;
}

.status-tip .lose-text {
  color: #94a3b8;
}

.control-area {
  display: flex;
  justify-content: center;
  align-items: center;
  flex: 1;
  margin: 30rpx 0;
}

.pulse-ring {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.pulse-ring.animating::before {
  content: '';
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  border-radius: 50%;
  border: 2px solid #10b981;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    transform: scale(0.95);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.15);
    opacity: 0.2;
  }
  100% {
    transform: scale(0.95);
    opacity: 0.8;
  }
}

.challenge-trigger-btn {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #059669 0%, #047857 100%);
  box-shadow: 0 12rpx 36rpx rgba(16, 185, 129, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
  user-select: none;
}

.challenge-trigger-btn.pressed {
  transform: scale(0.92);
  background: radial-gradient(circle, #dc2626 0%, #b91c1c 100%);
  box-shadow: 0 6rpx 20rpx rgba(220, 38, 38, 0.6);
}

.inner-circle {
  text-align: center;
}

.btn-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
}

.btn-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.result-board {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.result-icon-badge {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.result-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.winner .result-title {
  color: #34d399;
}

.loser .result-title {
  color: #f1f5f9;
}

.result-stat-row {
  display: flex;
  justify-content: space-around;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.stat-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 6rpx;
  font-family: monospace;
}

.result-detail-text {
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.6;
  margin-bottom: 36rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.04);
  padding: 20rpx;
  border-radius: 14rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.primary-btn {
  flex: 1;
  background: #10b981;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border: none;
}

.secondary-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.footer-bar {
  text-align: center;
  padding: 20rpx 0 10rpx;
}

.skip-btn {
  font-size: 26rpx;
  color: #cbd5e1;
  text-decoration: underline;
  padding: 12rpx 0;
}

.legal-note {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 12rpx;
}
